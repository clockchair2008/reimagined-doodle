# Local Postgres (default if DATABASE_URL is not set)
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zatca_einvoicing

# Neon (recommended): set DATABASE_URL and enable SSL
# Example format:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-xxxxxx.us-east-2.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# SSL flags (used automatically when DATABASE_URL is present)
DB_SSL=true
# Neon typically works with rejectUnauthorized=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Auth (set a strong secret in production / Railway)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Public frontend URL (used in password-reset emails)
FRONTEND_URL=https://portal.clockchair.com

# Email for forgot-password (prefer Resend on Railway — Hobby/Free blocks SMTP)
# 1) Create account at https://resend.com
# 2) Add API key below
# 3) Verify clockchair.com OR for a quick test use: SMTP_FROM=Clock Chair <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_FROM=Clock Chair Portal <admin@clockchair.com>

# Optional SMTP (only works on Railway Pro+, or locally). Dynadot host: webhost.dynadot.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@clockchair.com
SMTP_PASS=

# After creating a new Neon DB, from backend/:
#   npm run db:bootstrap
#   npm run seed:admin
#   npm run migration:run
